---
const linkGroups = [
  {
    heading: 'Help',
    links: [
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/terms', label: 'Terms & Conditions' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Contact' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface-subtle">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 md:grid-cols-3 md:px-6 lg:px-8">
    <a href="/" class="font-display text-2xl font-bold text-text">
      storefront
    </a>
    {
      linkGroups.map((group) => (
        <div>
          <p class="text-sm font-bold text-text">{group.heading}</p>
          <ul class="mt-4 space-y-2">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-text-secondary transition-colors hover:text-action"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <p class="text-xs text-text-muted md:col-span-3">© {year} storefront. All rights reserved.</p>
  </div>
</footer>
