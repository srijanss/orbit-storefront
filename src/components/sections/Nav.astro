---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<nav class="flex items-center border-b border-border bg-surface">
  <div class="mx-auto flex w-full max-w-7xl items-center px-4 py-6 md:px-6 lg:px-8">
    <div class="flex items-center gap-10">
      <a href="/" class="font-display text-2xl font-bold text-text">
        storefront
      </a>
      <ul class="flex items-center gap-8">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-text-secondary transition-colors hover:text-action">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>
