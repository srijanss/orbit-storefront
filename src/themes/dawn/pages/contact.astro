---
import Layout from '../layout.astro';

const contactEmail = 'hello@example.com';
---

<Layout title="Contact Us" description="Get in touch with us by email.">
  <main class="mx-auto max-w-5xl px-4 py-16 text-center md:px-6 md:py-24 lg:px-8">
    <h1 class="text-5xl leading-tight font-bold text-text">Contact Us</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-text-secondary">
      Have a question? Email us at
      <a
        class="font-bold text-action transition-colors hover:text-action-hover"
        href={`mailto:${contactEmail}`}
      >
        {contactEmail}
      </a>{' '}
      and we'll get back to you.
    </p>
  </main>
</Layout>
