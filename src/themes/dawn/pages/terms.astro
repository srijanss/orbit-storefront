---
import Layout from '../layout.astro';
---

<Layout title="Terms & Conditions" description="Lorem ipsum dolor sit amet, consectetur adipiscing elit.">
  <main class="mx-auto max-w-5xl px-4 py-16 text-center md:px-6 md:py-24 lg:px-8">
    <h1 class="text-5xl leading-tight font-bold text-text">Terms &amp; Conditions</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-text-secondary">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
      tempor incididunt ut labore et dolore magna aliqua.
    </p>
    <a
      href="/contact"
      class="mt-8 inline-block rounded-md bg-action px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-action-hover"
    >
      Get in Touch
    </a>
  </main>
</Layout>
