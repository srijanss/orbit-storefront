{
  "mcpServers": {
    "outside-in-tdd": {
      "command": "${CLAUDE_PROJECT_DIR:-.}/.agents/mcp/launch-outside-in-tdd.sh",
      "args": [
        "run",
        "outside-in-tdd-mcp"
      ]
    },
    "project-mcp": {
      "command": "/usr/local/bin/mcpctl",
      "args": [
        "run",
        "project-mcp"
      ]
    }
  }
}
